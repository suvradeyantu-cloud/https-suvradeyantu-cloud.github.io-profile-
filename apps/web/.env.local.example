# Next.js Supabase public credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Private Supabase service role key (Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI Scribe integrations
OPENAI_API_KEY=your_openai_api_key

# Doctor connected accounts & billing (Stripe Connect)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# 256-bit symmetric key for application-layer AES encryption (PII)
APP_ENCRYPTION_KEY=super_secure_symmetric_pass_phrase_32_characters
